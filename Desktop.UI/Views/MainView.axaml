<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Remotely.Desktop.UI.ViewModels"
			 xmlns:fakes="clr-namespace:Remotely.Desktop.UI.ViewModels.Fakes"
             mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="480"
             x:Class="Remotely.Desktop.UI.Views.MainView"
             x:DataType="vm:IMainViewViewModel">

	<Design.DataContext>
		<fakes:FakeMainViewViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto, 4, Auto, Auto, *, Auto" Background="{StaticResource BppPaper}">

		<!-- Header: dusk sky + badge, like the website header -->
		<Border Grid.Row="0" Background="{StaticResource BppDusk}" Padding="18,14">
			<Grid ColumnDefinitions="Auto, 14, *">
				<Image Grid.Column="0" Width="56" Height="56" Source="{Binding Icon}" VerticalAlignment="Center" />
				<StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
					<TextBlock Text="{Binding ProductName}" Foreground="{StaticResource BppCream}"
							   FontSize="21" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
					<TextBlock Text="REMOTE SUPPORT" Foreground="{StaticResource BppMint}"
							   FontFamily="{StaticResource BppMono}" FontSize="11" FontWeight="SemiBold" />
				</StackPanel>
			</Grid>
		</Border>
		<Border Grid.Row="1" Background="{StaticResource BppSun}" />

		<!-- Session code card -->
		<Border Grid.Row="2" Margin="16,16,16,0" Padding="16,14" Background="White"
				BorderBrush="{StaticResource BppLine}" BorderThickness="1" CornerRadius="14">
			<StackPanel Spacing="4">
				<TextBlock Classes="Kicker" Text="YOUR SESSION CODE" />
				<Grid ColumnDefinitions="*, Auto">
					<SelectableTextBlock Name="SessionIDTextBox" Grid.Column="0"
										 Text="{Binding StatusMessage}"
										 FontFamily="{StaticResource BppMono}" FontSize="30" FontWeight="Bold"
										 Foreground="{StaticResource BppInk}" VerticalAlignment="Center"
										 TextTrimming="CharacterEllipsis" />
					<Button Grid.Column="1" Classes="GhostButton" Command="{Binding CopyLinkCommand}"
							ToolTip.Tip="Copy an invite link you can text or email to your technician">
						Copy link
					</Button>
				</Grid>
				<TextBlock TextWrapping="Wrap" Foreground="{StaticResource BppMuted}" FontSize="13">
					Read this code to Steve, or text it to (760) 282-4859.
				</TextBlock>
				<TextBlock Foreground="{StaticResource BppTealInk}" FontWeight="SemiBold" FontSize="12"
						   IsVisible="{Binding IsCopyMessageVisible}" Opacity="{Binding CopyMessageOpacity}">
					Invite link copied to clipboard
				</TextBlock>
			</StackPanel>
		</Border>

		<!-- Connected technicians -->
		<Grid Grid.Row="3" Margin="18,16,18,6" ColumnDefinitions="*, Auto">
			<TextBlock Grid.Column="0" Classes="Kicker" Text="CONNECTED TECHNICIANS" />
			<TextBlock Grid.Column="1" Classes="Kicker" Foreground="{StaticResource BppMuted}" Text="HAS CONTROL" />
		</Grid>
		<Border Grid.Row="4" Margin="16,0,16,0" Background="White" BorderBrush="{StaticResource BppLine}"
				BorderThickness="1" CornerRadius="12" ClipToBounds="True">
			<Grid>
				<TextBlock Text="No one is connected yet." Foreground="{StaticResource BppMuted}" FontSize="13"
						   HorizontalAlignment="Center" VerticalAlignment="Center"
						   IsVisible="{Binding !Viewers.Count}" />
				<ListBox Name="ViewerListBox" Background="Transparent" VerticalAlignment="Stretch"
						 ItemsSource="{Binding Viewers}" SelectionMode="Multiple" SelectedItems="{Binding SelectedViewers}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid VerticalAlignment="Center" ColumnDefinitions="Auto, 10, *, Auto">
								<Ellipse Grid.Column="0" Width="9" Height="9" Fill="{StaticResource BppMint}" Stroke="{StaticResource BppTeal}" StrokeThickness="1.5" VerticalAlignment="Center" />
								<TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource BppInk}"
										   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
								<CheckBox Grid.Column="3" IsChecked="{Binding HasControl}" VerticalAlignment="Center" />
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>

		<!-- Footer -->
		<Grid Grid.Row="5" Margin="16,10,16,14" ColumnDefinitions="Auto, *, Auto">
			<Button x:Name="OptionsButton" Grid.Column="0"
					BorderThickness="0" Background="Transparent"
					VerticalAlignment="Center" HorizontalAlignment="Left"
					Cursor="Hand" Height="26" Width="26" Padding="3"
					VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"
					ToolTip.Tip="Settings"
					Command="{Binding OpenOptionsMenu}"
					CommandParameter="{Binding #OptionsButton}">
				<Button.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Change Server" Command="{Binding ChangeServerCommand}"></MenuItem>
					</ContextMenu>
				</Button.ContextMenu>
				<Image Source="avares://Desktop.UI/Assets/Gear.png" Stretch="Uniform" Opacity="0.6" />
			</Button>
			<TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap"
					   FontSize="12" Foreground="{StaticResource BppMuted}">
				Close this window to end support any time.
			</TextBlock>
			<Button Grid.Column="2" Classes="NormalButton" Command="{Binding RemoveViewersCommand}"
					ToolTip.Tip="Disconnect the selected technician">
				Disconnect
			</Button>
		</Grid>
	</Grid>
</UserControl>
